# Keep this file private; do not prefix secrets with a frontend environment variable.
G8_API_KEY=
PORT=4301
# Remote hosting (Render): all three are required when HOST is not localhost.
# HOST=0.0.0.0
# APP_ORIGIN=https://your-service.onrender.com
# ADMIN_TOKEN=long-random-string   (entered once in Connection settings for the growth pages)
# Optional
# BIDFLOW_MODEL=gpt-4o-mini
# BIDFLOW_SKILL_ID=
# SEED_USERS=[{"email":"issuer@example.com","name":"Demo Issuer","password":"change-me-12chars","role":"issuer"}]
# G8_WORKSPACE_FILE=server/data/workspace.json
