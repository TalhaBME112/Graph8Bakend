{
  "name": "graph8-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test:server": "node --test server/domain.test.mjs server/integration.test.mjs server/features.test.mjs server/graph8.test.mjs server/tender/marketplace.test.mjs server/tender/bidflow/engine.test.mjs server/growth/stats.test.mjs server/tender/network.test.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:market-browser": "node --test e2e/market.browser.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@graph8/sdk": "^0.245.0",
    "better-sqlite3": "^11.10.0",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "pdf-parse": "^1.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@playwright/test": "^1.63.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=20.19 <23"
  }
}
